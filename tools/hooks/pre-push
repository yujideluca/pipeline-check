#!/usr/bin/env bash
# Local stand-in for branch protection, for pipeline-check itself: before main is pushed, this working copy's own
# program runs the gate and the local checks (`--pre-push`, PC-13); a `falha` stops the push.
# Other projects use consumer/pre-push, which runs the pinned version; here the program under test is the one being pushed.
# Enable once per clone:  git config core.hooksPath tools/hooks      Bypass on purpose:  git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
[ -f ~/.cargo/env ] && source ~/.cargo/env
cargo build --release --quiet
exec target/release/pipeline-check --pre-push
